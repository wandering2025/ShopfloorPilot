# Live-agent configuration. Copy to `.env` (never commit `.env`) and set DEEPSEEK_API_KEY.
# The dashboard loads `.env` from the repository root; the CLI accepts --env-file.
# Without a key, the dashboard still runs with the deterministic planner and the
# recorded agent session (offline replay).

# Server-side credential: never paste a real key into tracked files, logs, prompts or UI.
DEEPSEEK_API_KEY=
# Alternatively point at a private file outside version control:
# DEEPSEEK_API_KEY_FILE=/path/to/private/deepseek_apikey.txt

DEEPSEEK_BASE_URL=https://api.deepseek.com
# The configuration used for the published evaluation. Verify current model names.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled

# Every paid run requires an explicit currency and hard monetary caps.
SHOPFLOOR_PROVIDER_CURRENCY=USD
SHOPFLOOR_PROVIDER_WORKFLOW_BUDGET=0.0125
SHOPFLOOR_PROVIDER_RUN_BUDGET=0.0125

# Dated per-1M-token rates used for cost estimates. Check the official pricing page
# and update these values and the date before relying on cost figures.
SHOPFLOOR_PROVIDER_INPUT_CACHE_HIT_RATE=0.006
SHOPFLOOR_PROVIDER_INPUT_CACHE_MISS_RATE=0.30
SHOPFLOOR_PROVIDER_OUTPUT_RATE=1.20
SHOPFLOOR_PROVIDER_TARIFF_DATE=2026-10-21
SHOPFLOOR_PROVIDER_TARIFF_SOURCE=https://api-docs.deepseek.com/quick_start/pricing/

# Optional ceilings (defaults shown): attempts, tool executions, retries, timeouts, tokens.
# SHOPFLOOR_PROVIDER_MAX_ATTEMPTS=8
# SHOPFLOOR_PROVIDER_MAX_TOOL_EXECUTIONS=16
# SHOPFLOOR_PROVIDER_MAX_RETRIES_PER_REQUEST=2
# SHOPFLOOR_PROVIDER_ATTEMPT_TIMEOUT_SECONDS=30
# SHOPFLOOR_PROVIDER_ACTIVE_SECONDS=120
# SHOPFLOOR_PROVIDER_MAX_TOKENS=32000
# SHOPFLOOR_PROVIDER_MAX_OUTPUT_TOKENS=1024
